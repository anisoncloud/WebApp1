@model WebApplication1.Dto.CreateProductDto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    @if (ViewBag.Categories != null)
        {
        foreach (var category in ViewBag.Categories)
            {
            <div class="form-check">
                <input name="CategoryIds"
                    class="form-check-input" 
                    type="checkbox" value="@category.Id" id="flexCheckDefault"
                @(Model.CategoryIds != null && Model.CategoryIds.Contains(category.Id) ? "checked" : "")>
                <label class="form-check-label" for="flexCheckDefault">
                    @category.Name
                </label>
            </div>
            }
        }
    
    
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Product Name</label>
        <input asp-for="Name" class="form-control" id="exampleFormControlInput1" placeholder="Your name">
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="exampleFormControlTextarea1" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" id="exampleFormControlTextarea1" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary px-4">Create Category</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}